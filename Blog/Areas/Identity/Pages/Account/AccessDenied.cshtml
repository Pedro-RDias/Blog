@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="container text-center my-5">
    <h1 class="text-danger display-4">@ViewData["Title"]</h1>
    <p class="text-danger lead">You do not have access to this resource.</p>
    <p class="mt-4">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-warning">Go to Home</a>
    </p>
</div>

