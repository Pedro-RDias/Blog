@{
ViewData["Title"] = "About Us";
}
<div class="container my-5">
    <!-- Título principal -->
    <h1 class="text-center mb-4"><i class="bi bi-egg-fried text-warning"></i> About Us</h1>

    <!-- Seção de Introdução -->
    <section class="mb-5">
        <h2><i class="bi bi-heart-fill text-warning"></i> Our Passion for Cooking</h2>
        <p>Welcome to our Recipe Blog! Our passion is to bring delicious, easy-to-follow recipes to home cooks everywhere. We believe that anyone can create amazing meals with the right guidance, and our mission is to provide that inspiration and support.</p>
    </section>

    <!-- Seção de Valores -->
    <section class="mb-5">
        <h2><i class="bi bi-award-fill text-warning"></i> Our Values</h2>
        <ul class="list-unstyled">
            <li><strong>Quality Ingredients:</strong> We believe great meals start with fresh, high-quality ingredients.</li>
            <li><strong>Community Focus:</strong> We aim to build a welcoming community of food lovers and home cooks.</li>
            <li><strong>Creativity in the Kitchen:</strong> We encourage trying new techniques and flavors.</li>
        </ul>
    </section>

    <!-- Seção de História -->
    <section class="mb-5">
        <h2><i class="bi bi-book-half text-warning"></i> Our Story</h2>
        <p>Our Recipe Blog started in 2020 as a small passion project, sharing family recipes and favorite dishes. Over the years, we have grown to become a trusted source of inspiration for home cooks. Today, we provide a wide variety of recipes, from easy weeknight meals to gourmet dishes, to suit all skill levels.</p>
    </section>
    
    <!-- Seção de Contacto -->
    <section class="mb-5">
        <h2><i class="bi bi-envelope text-warning"></i> Contact Us</h2>
        <p>We love hearing from our readers! If you have questions, recipe requests, or just want to say hello, feel free to reach out:</p>
        <p><strong>Email:</strong> <a href="mailto:info@recipeblog.com">info@recipeblog.com</a></p>
        <p><strong>Address:</strong> 123 Recipe Street, Culinary City, Country</p>
    </section>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
