@{
ViewData["Title"] = "Contact";
}
<div class="container my-5">
    <!-- Título principal -->
    <h1 class="text-center mb-4"><i class="bi bi-envelope text-warning"></i> Contact Us</h1>
    <p class="text-center text-muted">We’d love to hear from you! Whether you have questions, feedback, or just want to say hello, feel free to reach out.</p>

    <div class="row mb-5">
        <!-- Coluna 1: Localização e Email -->
        <div class="col-md-6">
            <!-- Seção de Localização -->
            <section class="mb-4">
                <h2><i class="bi bi-geo-alt-fill text-warning"></i> Our Location</h2>
                <p>123 Recipe Street, Culinary City, Country</p>
            </section>

            <!-- Seção de Email -->
            <section class="mb-4">
                <h2><i class="bi bi-envelope-fill text-warning"></i> Email Us</h2>
                <p>If you have any questions or feedback, please send us an email:</p>
                <p><strong>Email:</strong> <a href="mailto:info@recipeblog.com">info@recipeblog.com</a></p>
            </section>

            <!-- Seção de Telefone -->
            <section class="mb-4">
                <h2><i class="bi bi-telephone-fill text-warning"></i> Call Us</h2>
                <p>Our team is available to assist you. Feel free to give us a call:</p>
                <p><strong>Phone:</strong> +123 456 7890</p>
            </section>
        </div>

        <!-- Coluna 2: Formulário de Contato -->
        <div class="col-md-6">
            <section>
                <h2><i class="bi bi-chat-dots-fill text-warning"></i> Send Us a Message</h2>
                <form>
                    <div class="mb-3">
                        <label for="name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="name" placeholder="Your name">
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="email" placeholder="name@example.com">
                    </div>
                    <div class="mb-3">
                        <label for="message" class="form-label">Message</label>
                        <textarea class="form-control" id="message" rows="4" placeholder="Your message" style="resize:none"></textarea>
                    </div>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-send-fill"></i> Send Message</button>
                </form>
            </section>
        </div>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

