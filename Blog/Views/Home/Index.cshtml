@using System.Globalization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Blog.Controllers.RecipesViewIndexModel

@{
    ViewData["Title"] = "Sabor&Arte";
}

<main class="container my-4" style="max-width: 900px;">
    <div class="row">
        <section class="col-12 col-md-8 col-lg-10">
            @foreach (var item in Model.Recipes)
            {
            <div class="card mb-4 shadow-sm position-relative" style="border-radius: 12px; overflow: hidden;">
                <div class="image-container" style="position: relative;">
                    @if (item.Photos.Count > 0)
                    {
                    <img src="@item.Photos.ToList()[0].ImagePath"
                         class="img-fluid card-image" style="width: 100%; height: 200px; object-fit: cover;"
                         alt="Recipe image">
                    }
                    else
                    {
                    <img src="https://images.unsplash.com/photo-1617054240991-b0ffce6600da?q=80&w=1885&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                         class="img-fluid card-image" style="width: 100%; height: 200px; object-fit: cover;"
                         alt="Recipe image">
                    }
                    <!-- Overlay com o resumo da receita no hover -->
                    <div class="overlay">
                        <p class="overlay-text">@item.Summary</p>
                    </div>
                </div>

                <div class="card-body" style="padding: 1.5rem;">
                    <h5 class="card-title" style="display: flex; align-items: center; gap: 0.5rem;">
                        @Html.DisplayFor(modelItem => item.Title)
                        <span class="badge text-bg-secondary">@Html.DisplayFor(modelItem => item.Category)</span>
                    </h5>

                    <!-- Ingredientes -->
                    <h6 class="mt-4 fw-bold">Ingredients:</h6>
                    <ul class="list-unstyled">
                        @foreach (var ingredient in item.Ingredients)
                        {
                        <li>- @ingredient.Name: @ingredient.Quantity</li>
                        }
                    </ul>

                    <!-- Passos de Preparação -->
                    <h6 class="mt-4 fw-bold">Preparation Steps:</h6>
                    <ol>
                        @foreach (var step in item.PreparationSteps)
                        {
                        <li>@step.Description</li>
                        }
                    </ol>

                    <p class="card-text">
                        <small class="text-body-secondary">Created: @Html.DisplayFor(modelItem => item.DateCreated)</small>
                    </p>
                </div>
            </div>
            }

            @if (Model.Recipes.Count == 0)
            {
            <div class="alert alert-info text-center" style="margin-top: 20px;">
                No recipes found matching your criteria.
            </div>
            }

            <nav aria-label="Recipe pagination" class="d-flex justify-content-center mt-4">
                <ul class="pagination">
                    @if (Model.Recipes.HasPreviousPage)
                    {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.Recipes.PageIndex - 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-month="@Model.CurrentMonth"
                           asp-route-year="@Model.CurrentYear">
                            Previous
                        </a>
                    </li>
                    }
                    @if (Model.Recipes.HasNextPage)
                    {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.Recipes.PageIndex + 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-month="@Model.CurrentMonth"
                           asp-route-year="@Model.CurrentYear">
                            Next
                        </a>
                    </li>
                    }
                </ul>
            </nav>
        </section>

        <!-- Sidebar com a barra de pesquisa e filtros -->
        <section class="col-12 col-md-4 col-lg-2">
            <div class="mb-4" style="max-width: 250px;">
                <form method="get" class="input-group" style="width: 100%;">
                    <input type="hidden" name="PageNumber" value="1"/>
                    <input type="hidden" name="Month" value="@Model.FilterParams.Month"/>
                    <input type="hidden" name="Year" value="@Model.FilterParams.Year"/>
                    <input type="text"
                           name="SearchTerm"
                           value="@Model.SearchTerm"
                           class="form-control rounded-start"
                           placeholder="Search..."
                           style="border-radius: 20px 0 0 20px;"/>
                    <button type="submit" class="btn btn-primary rounded-start" style="border-radius: 20px 0 0 20px;">🔍</button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.CurrentMonth.HasValue)
                    {
                    <a asp-action="Index" class="btn btn-danger rounded-end custom-close-button" style="border-radius: 0 20px 20px 0; color: white; text-decoration: none;">
                        ✖
                    </a>
                    }
                </form>
            </div>

            <ul class="nav flex-column mb-4" style="border-radius: 8px; padding: 1rem; background-color: #f8f9fa; max-width: 250px;">
                @foreach (var year in Model.Dates.Keys.OrderByDescending(y => y))
                {
                <li class="nav-item">
                    <strong>@year</strong>
                    <ul class="list-unstyled ms-3">
                        @foreach (var month in Model.Dates[year].OrderByDescending(m => m))
                        {
                        <li>
                            <a class="nav-link text-primary @(Model.CurrentMonth == month && Model.CurrentYear == year ? "active" : "")"
                               style="font-size: 0.9rem;"
                               asp-action="Index"
                               asp-route-month="@month"
                               asp-route-year="@year"
                               asp-route-searchTerm="@Model.SearchTerm">
                                @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                            </a>
                        </li>
                        }
                    </ul>
                </li>
                }
            </ul>
        </section>
    </div>
</main>