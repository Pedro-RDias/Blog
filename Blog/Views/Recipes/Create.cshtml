@using Blog.Data.Enums
@using System.Text.Json
@model Blog.ViewModels.RecipeViewModel

@{
    ViewData["Title"] = "Create Recipe";
}
<h1>Create Recipe</h1>
<hr/>
<form asp-action="Create" id="recipeForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Title" class="control-label"></label>
        <input asp-for="Title" class="form-control"/>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Summary" class="control-label"></label>
        <textarea asp-for="Summary" class="form-control"></textarea>
        <span asp-validation-for="Summary" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Category" class="control-label"></label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<Category>()" class="form-control">
            <option selected="selected" value="">Please select</option>
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Diet" class="control-label"></label>
        <select asp-for="Diet" asp-items="Html.GetEnumSelectList<Diet>()" class="form-control">
            <option selected="selected" value="">Please select</option>
        </select>
        <span asp-validation-for="Diet" class="text-danger"></span>
    </div>

    <!-- Ingredients Section -->
    <h4>Ingredients</h4>
    <div id="ingredients"></div>
    <button type="button" id="addIngredientBtn" class="btn btn-secondary mt-2">Add Ingredient</button>

    <!-- Preparation Steps Section -->
    <h4>Preparation Steps</h4>
    <div id="steps"></div>
    <button type="button" id="addStepBtn" class="btn btn-secondary mt-2">Add Step</button>

    <!-- Hidden inputs for ingredients and steps -->
    <input type="hidden" id="ingredientsJson" name="IngredientsJson" value="@(Model?.Ingredients != null ? JsonSerializer.Serialize(Model.Ingredients) : "")" />
    <input type="hidden" id="stepsJson" name="StepsJson" value="@(Model?.PreparationSteps != null ? JsonSerializer.Serialize(Model.PreparationSteps) : "")" />

    <div class="form-group mt-3">
        <input type="submit" value="Create" class="btn btn-primary"/>
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/recipeForm.js"></script>
}