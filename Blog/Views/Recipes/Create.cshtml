@using System.Text.Json
@using Blog.Data.Enums
@model Blog.ViewModels.RecipeViewModel

@{
    ViewData["Title"] = "Create Recipe";
}
<div class="container mt-5">
    <h1 class="text-center mb-4">Create Recipe</h1>
    <hr/>

    <form asp-action="Create" method="post" id="recipeForm" class="border rounded p-4 bg-light" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Recipe Title -->
        <div class="form-group">
            <label asp-for="Title" class="control-label">Recipe Title</label>
            <input asp-for="Title" class="form-control" placeholder="Enter recipe title" maxlength="150"/>
            <small class="form-text text-muted">Max 150 characters.</small>
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <!-- Category and Diet Selection -->
        <div class="row my-3">
            <div class="col-md-6 form-group">
                <label asp-for="Category" class="control-label">Category</label>
                <select asp-for="Category" asp-items="Html.GetEnumSelectList<Category>()" class="form-select">
                    <option selected="selected" value="">Please select a category</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group">
                <label asp-for="Diet" class="control-label">Diet</label>
                <select asp-for="Diet" asp-items="Html.GetEnumSelectList<Diet>()" class="form-select">
                    <option selected="selected" value="">Please select a diet type</option>
                </select>
                <span asp-validation-for="Diet" class="text-danger"></span>
            </div>
        </div>

        <!-- Recipe Summary -->
        <div class="form-group mb-2">
            <label asp-for="Summary" class="control-label">Summary</label>
            <textarea asp-for="Summary" class="form-control" placeholder="Brief description of the recipe" maxlength="500"
                      style="resize: none; height: 100px;"></textarea>
            <small class="form-text text-muted">Max 500 characters.</small>
            <span asp-validation-for="Summary" class="text-danger"></span>
        </div>

        <div class="container mt-3">
            <div class="row">
                <!-- Ingredients Column -->
                <div class="col-md-6">
                    <h4 class="my-4">Ingredients</h4>
                    <div id="ingredients" class="border rounded p-3 mb-3 bg-light">
                        <!-- Ingredients will be added dynamically here -->
                    </div>
                    <div class="text-start">
                        <button type="button" id="addIngredientBtn" class="btn btn-secondary" style="background-color: rgba(240,90,40, 0.2); border-color: rgba(240,90,40, 0.2); color: black;">Add Ingredient</button>
                    </div>
                </div>

                <!-- Preparation Steps Column -->
                <div class="col-md-6">
                    <h4 class="my-4">Preparation Steps</h4>
                    <div id="steps" class="border rounded p-3 mb-3 bg-light">
                        <!-- Steps will be added dynamically here -->
                    </div>
                    <div class="text-start">
                        <button type="button" id="addStepBtn" class="btn btn-secondary" style="background-color: rgba(240,90,40, 0.2); border-color: rgba(240,90,40, 0.2); color: black;">Add Step</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Photos -->
        <div class="form-group">
            <label>Recipe Photos</label>
            <div id="photoUploadContainer">
                <div class="photo-upload-row mb-3">
                    <input type="file" name="photoFiles" class="form-control" accept="image/*" asp-for="Photos" multiple required/>
                </div>
            </div>
        </div>

        <!-- Hidden Inputs for Ingredients and Steps JSON -->
        <input type="hidden" id="ingredientsJson" name="IngredientsJson" value="@(Model?.Ingredients != null ? JsonSerializer.Serialize(Model.Ingredients) : "")"/>
        <input type="hidden" id="stepsJson" name="StepsJson" value="@(Model?.PreparationSteps != null ? JsonSerializer.Serialize(Model.PreparationSteps) : "")"/>

        <div class="form-check mb-3">
            <input asp-for="Published" class="form-check-input" type="checkbox" />
            <label asp-for="Published" class="form-check-label">Publish Recipe</label>
        </div>

        <!-- Botões de Ação -->
        <div class="text-end mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary me-2">Back to List</a>
            <input type="submit" value="Create" class="btn btn-primary" style="background-color: #8ea83d; border-color: #8ea83d;"/>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/recipeForm.js"></script>
}