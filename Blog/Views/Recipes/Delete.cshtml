@model Blog.Models.Recipe

@{
    ViewData["Title"] = "Delete Recipe";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Delete Recipe</h1>
    
    <h3 class="text-center text-danger">Are you sure you want to delete this?</h3>

    <div class="border rounded p-4 shadow-sm bg-light mt-4">
        <h4 class="mb-4 fw-bold text-dark">Recipe Information</h4>
        
        <dl class="row">
            <dt class="col-sm-3 fw-semibold text-secondary">
                @Html.DisplayNameFor(model => model.Title)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Title)
            </dd>

            <dt class="col-sm-3 fw-semibold text-secondary">
                @Html.DisplayNameFor(model => model.Summary)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Summary)
            </dd>

            <dt class="col-sm-3 fw-semibold text-secondary">
                @Html.DisplayNameFor(model => model.Category)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Category)
            </dd>

            <dt class="col-sm-3 fw-semibold text-secondary">
                @Html.DisplayNameFor(model => model.Diet)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Diet)
            </dd>

            <dt class="col-sm-3 fw-semibold text-secondary">
                @Html.DisplayNameFor(model => model.DateCreated)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DateCreated)
            </dd>

            <dt class="col-sm-3 fw-semibold text-secondary">
                @Html.DisplayNameFor(model => model.DateUpdated)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DateUpdated)
            </dd>

            <dt class="col-sm-3 fw-semibold text-secondary">
                @Html.DisplayNameFor(model => model.Author)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Author.UserName)
            </dd>
        </dl>
    </div>

    <!-- Formulário de Exclusão -->
    <div class="text-center mt-4">
        <form asp-action="Delete" style="display: inline;">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger fw-bold text-white" />
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold">Back to List</a>
    </div>
</div>
