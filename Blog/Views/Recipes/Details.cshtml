@model Blog.Models.Recipe

@{
    ViewData["Title"] = "Recipe Details";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Recipe Details</h1>
    <hr />

    <div class="border rounded p-4 bg-light">
        <h4 class="mb-4">Recipe Information</h4>

        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Title)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Title)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Summary)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Summary)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Category)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Category)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Diet)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Diet)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DateCreated)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DateCreated)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DateUpdated)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DateUpdated)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Author)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Author.Id)
            </dd>
        </dl>
    </div>
    
    @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
    {
        <div class="text-end mt-4">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary me-2" style="background-color: #8ea83d; border-color: #8ea83d;">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    }
</div>
