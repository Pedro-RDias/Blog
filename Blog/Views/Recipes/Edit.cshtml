@using Blog.Data.Enums
@using System.Text.Json
@model Blog.ViewModels.RecipeViewModel

@{
    ViewData["Title"] = "Edit Recipe";
}
<div class="container mt-5">
    <h1 class="text-center mb-4">Edit Recipe</h1>

    <form asp-action="Edit" method="post" id="recipeForm" class="p-4 shadow-sm bg-white rounded" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Recipe Title -->
        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-semibold">Recipe Title</label>
            <input asp-for="Title" class="form-control" placeholder="Enter recipe title" maxlength="25"/>
            <small class="text-muted">Max 25 characters.</small>
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <!-- Category and Diet Selection -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Category" class="form-label fw-semibold">Category</label>
                <select asp-for="Category" asp-items="Html.GetEnumSelectList<Category>()" class="form-select">
                    <option selected="selected" value="">Please select a category</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Diet" class="form-label fw-semibold">Diet</label>
                <select asp-for="Diet" asp-items="Html.GetEnumSelectList<Diet>()" class="form-select">
                    <option selected="selected" value="">Please select a diet type</option>
                </select>
                <span asp-validation-for="Diet" class="text-danger"></span>
            </div>
        </div>

        <!-- Recipe Summary -->
        <div class="mb-4"> 
            <label asp-for="Summary" class="form-label fw-semibold">Summary</label>
            <textarea asp-for="Summary" class="form-control" placeholder="Brief description of the recipe" maxlength="200" style="resize: none; height: 100px;"></textarea>
            <small class="text-muted">Max 200 characters.</small>
            <span asp-validation-for="Summary" class="text-danger"></span>
        </div>

        <div class="row">
            <!-- Ingredients Column -->
            <div class="col-md-6">
                <h4 class="mb-3 fw-bold text-dark">Ingredients</h4>
                <div id="ingredients" class="p-3 bg-light rounded mb-3">
                    <!-- Ingredients will be added dynamically here -->
                </div>
                <button type="button" id="addIngredientBtn" class="btn btn-outline-secondary fw-semibold">Add Ingredient</button>
            </div>

            <!-- Preparation Steps Column -->
            <div class="col-md-6">
                <h4 class="mb-3 fw-bold text-dark">Preparation Steps</h4>
                <div id="steps" class="p-3 bg-light rounded mb-3">
                    <!-- Steps will be added dynamically here -->
                </div>
                <button type="button" id="addStepBtn" class="btn btn-outline-secondary fw-semibold">Add Step</button>
            </div>
        </div>

        <!-- Photos -->
        <div class="mt-4">
            <label class="form-label fw-semibold">Recipe Photos</label>
            @if (Model.Photos != null && Model.Photos.Any())
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var photo in Model.Photos)
                    {
                        <div class="position-relative">
                            <img src="@photo.ImagePath" class="rounded" style="width: 150px; height: 150px; object-fit: cover;" />
                            <button type="button" class="btn-close position-absolute top-0 end-0 m-1" data-photo-id="@photo.Id" onclick="removePhoto(this)"></button>
                        </div>
                    }
                </div>
            }
            <input type="file" name="photoFiles" class="form-control" accept="image/*" multiple />
            <input type="hidden" id="removedPhotos" name="removedPhotos" value="" />
        </div>

        <!-- Hidden Inputs for Ingredients and Steps JSON -->
        @{
            var ingredientsJson = JsonSerializer.Serialize(Model.Ingredients);
            var stepsJson = JsonSerializer.Serialize(Model.PreparationSteps);
        }
        <input type="hidden" id="ingredientsJson" name="IngredientsJson" value="@ingredientsJson" />
        <input type="hidden" id="stepsJson" name="StepsJson" value="@stepsJson" />

        <!-- Publish Option -->
        <div class="form-check my-4">
            <input asp-for="Published" class="form-check-input" />
            <label asp-for="Published" class="form-check-label fw-semibold">Publish Recipe</label>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary fw-bold">Back to List</a>
            <input type="submit" value="Save Changes" class="btn fw-bold text-white" style="background-color: #f4ba18; border-color: #f4ba18;"/>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/updateRecipeForm.js"></script>
    <script>
        function removePhoto(button) {
            const photoId = button.getAttribute('data-photo-id');
            const removedPhotosInput = document.getElementById('removedPhotos');
            const removedPhotos = removedPhotosInput.value ? removedPhotosInput.value.split(',') : [];
            removedPhotos.push(photoId);
            removedPhotosInput.value = removedPhotos.join(',');
            button.closest('.position-relative').remove();
        }
    </script>
}

