@model User

@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Delete User</h1>
    <h3 class="text-center text-danger">Are you sure you want to delete this user?</h3>
    
    <div class="card shadow-sm border-0">
        <div class="card-body bg-light p-4">
            <h4 class="text-secondary">User Information</h4>
            <hr/>
            <dl class="row">
                <dt class="col-sm-3 fw-semibold text-secondary">First Name</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FirstName)</dd>

                <dt class="col-sm-3 fw-semibold text-secondary">Last Name</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.LastName)</dd>

                <dt class="col-sm-3 fw-semibold text-secondary">Email</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

                <!-- Phone Number -->
                <dt class="col-sm-3 fw-semibold text-secondary">Phone Number</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        @Model.PhoneNumber
                    }
                    else
                    {
                        <span class="text-muted">Not available</span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id"/>
                <div class="d-flex gap-3 justify-content-center">
                    <input type="submit" value="Delete" class="btn btn-danger fw-bold text-white"/>
                    <a asp-action="Index" class="btn btn-secondary fw-bold">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>