@{ ViewData["Title"] = "Edit "; }

<h1>Edit</h1>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Blog.Controllers.UserRoleViewModel

<h2>Edit User Roles</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>User: @Model.Email</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="UserId"/>
                    <input type="hidden" asp-for="UserName"/>
                    <input type="hidden" asp-for="Email"/>

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        @for (var i = 0; i < Model.Roles.Count; i++)
                        {
                            <div class="form-check mb-2">
                                <input type="hidden" asp-for="@Model.Roles[i].RoleId"/>
                                <input type="hidden" asp-for="@Model.Roles[i].RoleName"/>
                                <input class="form-check-input" type="checkbox" asp-for="@Model.Roles[i].IsSelected"/>
                                <label class="form-check-label" asp-for="@Model.Roles[i].IsSelected">
                                    @Model.Roles[i].RoleName
                                </label>
                            </div>
                        }
                    </div>

                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>