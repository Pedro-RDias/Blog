@{ ViewData["Title"] = "User Roles"; }



@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Blog.Controllers.UserRoleViewModel

<div class="container mt-5">
    <h1 class="text-center mb-4">@ViewData["Title"]</h1>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">User: @Model.Email</h5>
                </div>
                <div class="card-body bg-light">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="UserId"/>
                        <input type="hidden" asp-for="UserName"/>
                        <input type="hidden" asp-for="Email"/>

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            @for (var i = 0; i < Model.Roles.Count; i++)
                            {
                                <div class="form-check mb-2">
                                    <input type="hidden" asp-for="@Model.Roles[i].RoleId"/>
                                    <input type="hidden" asp-for="@Model.Roles[i].RoleName"/>
                                    <input class="form-check-input" type="checkbox" asp-for="@Model.Roles[i].IsSelected"/>
                                    <label class="form-check-label fw-semibold text-secondary" asp-for="@Model.Roles[i].IsSelected">
                                        @Model.Roles[i].RoleName
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="form-group mt-3 d-flex gap-2">
                            <button type="submit" class="btn btn-success fw-bold text-white">Save Changes</button>
                            <a asp-action="Index" class="btn btn-secondary fw-bold">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
